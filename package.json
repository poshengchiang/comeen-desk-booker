{
    "name": "comeen-desk-booker-extension",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Chrome extension that books a fixed desk in Comeen using the session already open in the browser.",
    "scripts": {
        "build": "node build.mjs",
        "watch": "node build.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/*.test.ts"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.287",
        "@types/node": "^22.10.2",
        "esbuild": "^0.24.2",
        "playwright": "^1.62.1",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
